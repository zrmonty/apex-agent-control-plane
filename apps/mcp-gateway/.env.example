# Explicit local-development standalone example, not a production default.
# The in-process adapter requires the development environment/profile below.
NODE_ENV=development
APEX_MCP_PROFILE=development-standalone
APEX_MCP_PRINCIPAL=spiffe://apex/agent/research
APEX_MCP_AGENT_ID=research-agent
APEX_MCP_WORKSPACE_ID=northstar
APEX_MCP_NAMESPACE_ID=research
APEX_MCP_TRACE_ID=trace-001
APEX_MCP_ALLOWED_PORTFOLIOS=northstar-401k
APEX_MCP_GOVERNANCE_MODE=local

# Retained managed-listener example keys; inactive in this standalone profile.
# They do not supply generated configuration or authorize managed serving.
APEX_MCP_LISTEN_HOST=127.0.0.1
APEX_MCP_LISTEN_PORT=8080
APEX_MCP_INBOUND_JWKS_FILE=./secrets-host/inbound-jwks.json

# Live Apex governance reference settings (unused by this local profile).
# A managed live deployment requires its own complete mTLS/token material.
APEX_MCP_TRUSTED_SECRET_BASE=./secrets-host
APEX_MCP_GOVERNANCE_ENDPOINT=127.0.0.1:18446
APEX_MCP_GOVERNANCE_CA_FILE=./secrets-host/ca.pem
APEX_MCP_GOVERNANCE_CLIENT_CERT_FILE=./secrets-host/mcp-gateway-client.pem
APEX_MCP_GOVERNANCE_CLIENT_KEY_FILE=./secrets-host/mcp-gateway-client.key
APEX_MCP_GOVERNANCE_TOKEN_FILE=./secrets-host/mcp-gateway-token

# Live event admission client (the event credential is separate from the
# governance credential and remains certificate-bound by event-ingest).
APEX_MCP_EVENT_ENDPOINT=127.0.0.1:18445
APEX_MCP_EVENT_CA_FILE=./secrets-host/ca.pem
APEX_MCP_EVENT_CLIENT_CERT_FILE=./secrets-host/ingest-http-client.pem
APEX_MCP_EVENT_CLIENT_KEY_FILE=./secrets-host/ingest-http-client.key
APEX_MCP_EVENT_TOKEN_FILE=./secrets-host/ingest-bearer-token
