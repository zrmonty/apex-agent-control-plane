# Rust
target/
# Keep generated Rust build trees and per-test secret fixtures out of every
# workspace crate, including crates added below the current directory.
**/target/
**/test-secrets/
**/test-secrets-*/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Runtime data
data/
tmp/
*.log
deploy/compose/.env
deploy/compose/secrets/
# Live mTLS handshake fixtures (PKI, ACL, passwords, rendered server configs).
# Scripts and stubs under live-mtls/ remain tracked; only generated secrets are ignored.
deploy/compose/live-mtls/secrets/
.local/
