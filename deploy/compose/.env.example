# Replace every image with an approved immutable digest before use.
APEX_INGEST_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_ORG/apex-event-ingest@sha256:REPLACE_WITH_APPROVED_DIGEST
NATS_IMAGE=nats@sha256:REPLACE_WITH_APPROVED_DIGEST
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server@sha256:REPLACE_WITH_APPROVED_DIGEST
MINIO_IMAGE=minio/minio@sha256:REPLACE_WITH_APPROVED_DIGEST
MINIO_MC_IMAGE=minio/mc@sha256:REPLACE_WITH_APPROVED_DIGEST
CLICKHOUSE_API_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_ORG/apex-clickhouse-projection@sha256:REPLACE_WITH_APPROVED_DIGEST
ARCHIVE_API_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_ORG/apex-archive-provider@sha256:REPLACE_WITH_APPROVED_DIGEST
APEX_CONTROL_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_ORG/apex-control-plane-api@sha256:REPLACE_WITH_APPROVED_DIGEST

# The gateway binds localhost by default. Change APEX_INGEST_BIND only after
# network policy and client certificate issuance are ready.
APEX_INGEST_BIND=127.0.0.1
# Required when intentionally binding outside loopback; review firewall and mTLS first.
APEX_ALLOW_NONLOCAL_INGEST_BIND=false
APEX_INGEST_PORT=8443

# Out-of-band control gateway (apps/control-plane-api). Same rule as the
# ingest gateway, and it matters more here: this is the channel that can stop,
# pause, or inject into a running agent.
APEX_CONTROL_BIND=127.0.0.1
APEX_ALLOW_NONLOCAL_CONTROL_BIND=false
APEX_CONTROL_PORT=9443
# Defaults target the authenticated provider services in this Compose profile.
# Override only with another HTTPS endpoint implementing the frozen contracts.
APEX_CLICKHOUSE_ENDPOINT=https://clickhouse-projection:8443/v1/events
APEX_ARCHIVE_ENDPOINT=https://archive-provider:8443/v1/events
# The sink endpoints above resolve to private, in-network hostnames, so the
# gateway must be told to trust exactly them. Do not widen APEX_PRIVATE_SINK_HOSTS
# beyond the sinks this deployment actually owns.
APEX_ALLOW_PRIVATE_SINK_DESTINATIONS=1
APEX_PRIVATE_SINK_HOSTS=clickhouse-projection,archive-provider
APEX_ARCHIVE_BUCKET=apex-events
APEX_ARCHIVE_REQUIRE_OBJECT_LOCK=false
APEX_ALLOWED_SCOPES=workspace/namespace
APEX_BEARER_AGENT_ID=reference-agent
# SHA-256 fingerprint (64 hex characters) of the client certificate allowed
# to use the bearer token. Compute from the DER certificate, not the PEM text.
APEX_BEARER_CERT_SHA256=REPLACE_WITH_CLIENT_CERT_SHA256
# SHA-256 fingerprint of the client certificate the gateway presents to the
# ClickHouse-projection and archive providers. The providers pin their write
# APIs to exactly this leaf and fail closed (403) without it. Usually the same
# value as APEX_BEARER_CERT_SHA256, when the gateway uses one client identity.
APEX_PROVIDER_CLIENT_CERT_SHA256=REPLACE_WITH_CLIENT_CERT_SHA256
APEX_RETRY_ATTEMPTS=3
APEX_IDEMPOTENCY_CAPACITY=50000
# The gateway's append-only outbox must live on a persistent volume. It is
# replayed before the service accepts traffic after a restart.
APEX_OUTBOX_FILE=/var/lib/apex/outbox.jsonl
APEX_OUTBOX_BASE=/var/lib/apex
APEX_IDEMPOTENCY_FILE=/var/lib/apex/idempotency.jsonl
APEX_IDEMPOTENCY_BASE=/var/lib/apex

# Point these at local files outside version control. They are mounted as
# Compose secrets, never passed as arguments or environment values.
NATS_CONFIG_FILE=./secrets/nats.conf
CLICKHOUSE_USERS_CONFIG_FILE=./secrets/clickhouse-users.xml
CLICKHOUSE_TLS_CONFIG_FILE=./secrets/clickhouse-tls.xml
CLICKHOUSE_SERVER_CERT_FILE=./secrets/clickhouse-server-cert.pem
CLICKHOUSE_SERVER_KEY_FILE=./secrets/clickhouse-server-key.pem
CLICKHOUSE_CLIENT_CA_FILE=./secrets/clickhouse-client-ca.pem
MINIO_ROOT_USER_FILE=./secrets/minio-root-user
MINIO_ROOT_PASSWORD_FILE=./secrets/minio-root-password
MINIO_SERVER_CERT_FILE=./secrets/minio-server-cert.pem
MINIO_SERVER_KEY_FILE=./secrets/minio-server-key.pem
MINIO_SERVER_CA_FILE=./secrets/minio-server-ca.pem
NATS_SERVER_CERT_FILE=./secrets/nats-server-cert.pem
NATS_SERVER_KEY_FILE=./secrets/nats-server-key.pem
NATS_CLIENT_CA_FILE=./secrets/nats-client-ca.pem
CLICKHOUSE_API_SERVER_CERT_FILE=./secrets/clickhouse-api-server-cert.pem
CLICKHOUSE_API_SERVER_KEY_FILE=./secrets/clickhouse-api-server-key.pem
CLICKHOUSE_API_CLIENT_CA_FILE=./secrets/clickhouse-api-client-ca.pem
CLICKHOUSE_WRITER_CERT_FILE=./secrets/clickhouse-writer-cert.pem
CLICKHOUSE_WRITER_KEY_FILE=./secrets/clickhouse-writer-key.pem
ARCHIVE_API_SERVER_CERT_FILE=./secrets/archive-api-server-cert.pem
ARCHIVE_API_SERVER_KEY_FILE=./secrets/archive-api-server-key.pem
ARCHIVE_API_CLIENT_CA_FILE=./secrets/archive-api-client-ca.pem
ARCHIVE_WRITER_CERT_FILE=./secrets/archive-writer-cert.pem
ARCHIVE_WRITER_KEY_FILE=./secrets/archive-writer-key.pem
ARCHIVE_BACKEND_ACCESS_KEY_FILE=./secrets/archive-backend-access-key
ARCHIVE_BACKEND_SECRET_KEY_FILE=./secrets/archive-backend-secret-key
GATEWAY_SERVER_CERT_FILE=./secrets/gateway-server-cert.pem
GATEWAY_SERVER_KEY_FILE=./secrets/gateway-server-key.pem
GATEWAY_CLIENT_CA_FILE=./secrets/gateway-client-ca.pem
# Control gateway TLS. A separate server leaf and a separate client CA from
# the ingest gateway's, so an ingest workload certificate cannot open a
# control connection. Every private CONTROL_* file below must be
# chown 10002 chmod 0400 on the host -- see compose.yaml's header.
CONTROL_SERVER_CERT_FILE=./secrets/control-server-cert.pem
CONTROL_SERVER_KEY_FILE=./secrets/control-server-key.pem
CONTROL_CLIENT_CA_FILE=./secrets/control-client-ca.pem
# Operator credential table: token|workspace/namespace[,...];token|*;...
# ('*' is the global break-glass scope). Tokens must be at least 16 bytes of
# printable ASCII. A file, not an environment value: `docker inspect` and
# /proc/<pid>/environ both expose environment.
CONTROL_OPERATOR_TOKENS_FILE=./secrets/control-operator-tokens
# Agent workload credential table, for PollCommands:
#   token|cert_sha256|agent_id|workspace/namespace[,...];...
# A separate file and a separate credential space from the operator table
# above, because issuing a `stop` and retrieving one are different authorities
# held by different principals (ADR-0006). The 64-hex fingerprint pins the
# credential to exactly one mTLS client certificate, so a leaked token is
# unusable from any other connection. There is no '*' form: an agent workload
# has exactly one identity.
#
# Leaving this unset is supported and announced loudly on stderr -- the gateway
# then accepts commands that no agent can ever retrieve.
CONTROL_AGENT_TOKENS_FILE=./secrets/control-agent-tokens
# The control gateway's own NATS client identity and broker account, used by
# the background fanout worker that turns an accepted command into a `control`
# event in the queryable trace. Distinct from INGEST_NATS_* / NATS_USERNAME /
# NATS_PASSWORD below on purpose: ADR-0006's credential separation has to hold
# at the broker too. Grant this account publish on the event subjects only --
# it never creates or manages a stream.
CONTROL_NATS_CLIENT_CERT_FILE=./secrets/control-nats-client-cert.pem
CONTROL_NATS_CLIENT_KEY_FILE=./secrets/control-nats-client-key.pem
CONTROL_NATS_USERNAME_FILE=./secrets/control-nats-username
CONTROL_NATS_PASSWORD_FILE=./secrets/control-nats-password
# Fanout tick, seconds (1..3600). Default 5, matching event-ingest's own
# outbox replay worker. Faster contends with the accept path on the shared
# outbox mutex; slower makes a `stop` look dropped to the operator watching.
APEX_CONTROL_FANOUT_INTERVAL_SECS=5
# Settled command delivery state and command-id idempotency retention,
# seconds (1 hour..365 days). Default 30 days.
APEX_CONTROL_COMMAND_RETENTION_SECS=2592000
# Optional: selects the multi-writer Postgres outbox instead of the
# single-writer file outbox. Requires an image built with --features postgres.
# MUST resolve to a database or schema of the control gateway's own --
# apex_event_outbox is a shared table name, so pointing this and the ingest
# gateway at one database gives them one outbox table and each service's
# replay worker would claim and republish the other's rows.
# APEX_CONTROL_POSTGRES_URL=postgres://apex@postgres/apex_control?sslmode=verify-full
#
# The command inbox (delivery state for PollCommands: has the target agent
# retrieved this yet) follows the Postgres outbox into the separate
# apex_control_inbox table, so agents may poll any replica. With the file
# backend it remains a single-writer journal on the configured local volume.
# Where the file-backend inbox journal lives. Defaults to
# APEX_CONTROL_OUTBOX_BASE; ignored when the Postgres inbox is selected.
# APEX_CONTROL_INBOX_BASE=/var/lib/apex-control
# APEX_CONTROL_INBOX_FILE=inbox.jsonl
#
# --- Operator credentials: Keycloak (production) --------------------------
# Setting APEX_CONTROL_KEYCLOAK_ISSUER selects the production verifier and is
# refused alongside APEX_CONTROL_OPERATOR_TOKENS_FILE / _TOKENS -- two
# configured credential sources means one is silently ignored. Keycloak
# performs the RFC 8693 token exchange; this gateway is a resource server that
# holds no client secret and only verifies what Keycloak issued.
# APEX_CONTROL_KEYCLOAK_ISSUER=https://sso.example.com/realms/apex
# APEX_CONTROL_KEYCLOAK_AUDIENCE=apex-control-gateway
# CA the JWKS endpoint's certificate must chain to. It REPLACES the trust
# store rather than adding to it, so no publicly-trusted certificate can stand
# in for the realm.
# CONTROL_KEYCLOAK_CA_FILE=./secrets/control-keycloak-ca.pem
# Defaults to {issuer}/protocol/openid-connect/certs. Overriding it is
# supported for split-horizon deployments and asserts that the URL serves the
# configured issuer's keys.
# APEX_CONTROL_KEYCLOAK_JWKS_URL=
# Refresh interval (30..3600, default 300) is also the bound on how long a key
# Keycloak has rotated away keeps verifying tokens here. Max age (30..86400,
# default 900) is the staleness ceiling: past it the gateway refuses every
# credential with CREDENTIAL_VERIFIER_UNAVAILABLE rather than trusting keys of
# unknown age. Max age must be at least the refresh interval.
# APEX_CONTROL_KEYCLOAK_JWKS_REFRESH_SECS=300
# APEX_CONTROL_KEYCLOAK_JWKS_MAX_AGE_SECS=900
# Allow-listed claims. A `*` in the scope claim rejects the whole token; it
# never widens a grant and is never silently dropped.
# APEX_CONTROL_KEYCLOAK_SCOPE_CLAIM=apex_control_scopes
# APEX_CONTROL_KEYCLOAK_ROLE_CLAIM=realm_access.roles
# The ONLY route to the `*` break-glass operator scope, and both are required
# together (setting one alone is a startup error). A Keycloak claim can never
# confer `*` on its own: the subject allow-list is local configuration the
# identity provider does not control, so an over-broad group-to-role mapping
# cannot by itself hand anyone rights over every workspace. Unset by default,
# i.e. `*` is unreachable.
# APEX_CONTROL_KEYCLOAK_GLOBAL_ROLE=apex-control-break-glass
# APEX_CONTROL_KEYCLOAK_GLOBAL_SUBJECTS=
# Ceiling on exp-iat (60..86400, default 3600), which is what makes
# "short-lived" enforced rather than described.
# APEX_CONTROL_KEYCLOAK_MAX_TOKEN_LIFETIME_SECS=3600
# Keycloak signs ID, access and refresh tokens with the same realm keys, and an
# ID token's `aud` is the client id. Default `Bearer`; the waiver is
# exact-match and setting both is refused.
# APEX_CONTROL_KEYCLOAK_EXPECTED_TYP=Bearer
# APEX_CONTROL_KEYCLOAK_ALLOW_ANY_TOKEN_TYP=true
#
# --- Admission ceiling ----------------------------------------------------
# Per-operator ceiling. With no shared store this is per replica, so N replicas
# admit N x the limit.
# APEX_CONTROL_ADMISSION_LIMIT=50
# APEX_CONTROL_ADMISSION_WINDOW_SECS=1
# Optional cross-replica ceiling, reusing event-ingest's EphemeralStore/Valkey
# adapter. Requires an image built with --features valkey; setting the host
# without it is a hard startup error. Never authoritative: the process-local
# ceiling stays the hard floor, an unreachable instance degrades to it rather
# than failing open, and a Valkey that is down at startup does not stop this
# gateway coming up.
#
# THIS MUST BE THE CONTROL GATEWAY'S OWN VALKEY INSTANCE AND OWN ACL USER.
# APEX_VALKEY_HOST on this process is refused outright. event-ingest's Valkey
# key prefix is the fixed literal `apex:ingest`, so a shared instance would put
# both services' rate-limit counters in one keyspace under one credential.
# APEX_CONTROL_VALKEY_HOST=control-valkey
# APEX_CONTROL_VALKEY_PORT=6379
# APEX_CONTROL_VALKEY_USERNAME=apex-control
# CONTROL_VALKEY_PASSWORD_FILE=./secrets/valkey-control-password
# CONTROL_VALKEY_CA_FILE=./secrets/valkey-server-ca.pem
# CONTROL_VALKEY_CLIENT_CERT_FILE=./secrets/control-valkey-client-cert.pem
# CONTROL_VALKEY_CLIENT_KEY_FILE=./secrets/control-valkey-client-key.pem
INGEST_BEARER_TOKEN_FILE=./secrets/ingest-bearer-token
NATS_USERNAME_FILE=./secrets/nats-username
NATS_PASSWORD_FILE=./secrets/nats-password
INGEST_NATS_CLIENT_CERT_FILE=./secrets/ingest-nats-client-cert.pem
INGEST_NATS_CLIENT_KEY_FILE=./secrets/ingest-nats-client-key.pem
INGEST_CLICKHOUSE_CLIENT_CERT_FILE=./secrets/ingest-clickhouse-client-cert.pem
INGEST_CLICKHOUSE_CLIENT_KEY_FILE=./secrets/ingest-clickhouse-client-key.pem
ARCHIVE_CLIENT_CA_FILE=./secrets/archive-client-ca.pem
INGEST_ARCHIVE_CLIENT_CERT_FILE=./secrets/ingest-archive-client-cert.pem
INGEST_ARCHIVE_CLIENT_KEY_FILE=./secrets/ingest-archive-client-key.pem

# Optional Valkey acceleration (use with -f compose.valkey.yaml)
VALKEY_IMAGE=valkey/valkey@sha256:REPLACE_WITH_APPROVED_DIGEST
VALKEY_CONFIG_FILE=./secrets/valkey.conf
VALKEY_ACL_FILE=./secrets/valkey.acl
VALKEY_SERVER_CERT_FILE=./secrets/valkey-server-cert.pem
VALKEY_SERVER_KEY_FILE=./secrets/valkey-server-key.pem
VALKEY_CLIENT_CA_FILE=./secrets/valkey-client-ca.pem
VALKEY_SERVER_CA_FILE=./secrets/valkey-server-ca.pem
VALKEY_INGEST_PASSWORD_FILE=./secrets/valkey-ingest-password
INGEST_VALKEY_CLIENT_CERT_FILE=./secrets/ingest-valkey-client-cert.pem
INGEST_VALKEY_CLIENT_KEY_FILE=./secrets/ingest-valkey-client-key.pem
APEX_VALKEY_USERNAME=apex-ingest

# Optional Azure Blob archive backend (use with -f compose.azure.yaml)
# Gateway stays cloud-agnostic; only archive-provider loads these secrets.
# Prefer connection-string file; leave account-key empty placeholder when unused.
APEX_ARCHIVE_AZURE_CONTAINER=apex-events
# APEX_ARCHIVE_AZURE_ACCOUNT_URL=https://YOUR_ACCOUNT.blob.core.windows.net
AZURE_CONNECTION_STRING_FILE=./secrets/azure-connection-string
AZURE_ACCOUNT_KEY_FILE=./secrets/azure-account-key

# Optional GCS archive backend (use with -f compose.gcs.yaml)
APEX_ARCHIVE_GCS_BUCKET=your-apex-events-bucket
# APEX_ARCHIVE_GCS_PROJECT=your-gcp-project
GCS_CREDENTIALS_FILE=./secrets/gcs-service-account.json

# Optional: anti-spoof signed agent bundles (SDK).
# Directory of operator Ed25519 public PEMs named {key_id}.pem (never agent-writable).
# APEX_BUNDLE_TRUST_KEYS_DIR=./secrets/bundle-trust-keys
# Pins (key_id → SHA-256 of raw public key) so dropped PEMs cannot expand trust:
# APEX_BUNDLE_TRUST_PINS=ops-1:0123...64hex
# APEX_BUNDLE_TRUST_PINS_FILE=./secrets/bundle-trust-keys/trust.pins
# APEX_BUNDLE_REQUIRE_TRUST_PINS=true
