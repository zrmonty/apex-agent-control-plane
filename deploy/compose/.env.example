# Replace every image with an approved immutable digest before use.
APEX_INGEST_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_ORG/apex-event-ingest@sha256:REPLACE_WITH_APPROVED_DIGEST
NATS_IMAGE=nats@sha256:REPLACE_WITH_APPROVED_DIGEST
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server@sha256:REPLACE_WITH_APPROVED_DIGEST
MINIO_IMAGE=minio/minio@sha256:REPLACE_WITH_APPROVED_DIGEST
MINIO_MC_IMAGE=minio/mc@sha256:REPLACE_WITH_APPROVED_DIGEST
CLICKHOUSE_API_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_ORG/apex-clickhouse-projection@sha256:REPLACE_WITH_APPROVED_DIGEST
ARCHIVE_API_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_ORG/apex-archive-provider@sha256:REPLACE_WITH_APPROVED_DIGEST

# The gateway binds localhost by default. Change APEX_INGEST_BIND only after
# network policy and client certificate issuance are ready.
APEX_INGEST_BIND=127.0.0.1
APEX_INGEST_PORT=8443
# Defaults target the authenticated provider services in this Compose profile.
# Override only with another HTTPS endpoint implementing the frozen contracts.
APEX_CLICKHOUSE_ENDPOINT=https://clickhouse-projection:8443/v1/events
APEX_ARCHIVE_ENDPOINT=https://archive-provider:8443/v1/events
APEX_ARCHIVE_BUCKET=apex-events
APEX_ARCHIVE_REQUIRE_OBJECT_LOCK=false
APEX_ALLOWED_SCOPES=workspace/namespace
APEX_RETRY_ATTEMPTS=3
APEX_IDEMPOTENCY_CAPACITY=50000
# This gateway currently has bounded in-memory idempotency. Keep true only for
# Phase 0 staging; production requires a durable idempotency store integration.
APEX_ALLOW_IN_MEMORY_IDEMPOTENCY=true

# Point these at local files outside version control. They are mounted as
# Compose secrets, never passed as arguments or environment values.
NATS_CONFIG_FILE=./secrets/nats.conf
CLICKHOUSE_USERS_CONFIG_FILE=./secrets/clickhouse-users.xml
CLICKHOUSE_TLS_CONFIG_FILE=./secrets/clickhouse-tls.xml
CLICKHOUSE_SERVER_CERT_FILE=./secrets/clickhouse-server-cert.pem
CLICKHOUSE_SERVER_KEY_FILE=./secrets/clickhouse-server-key.pem
CLICKHOUSE_CLIENT_CA_FILE=./secrets/clickhouse-client-ca.pem
MINIO_ROOT_USER_FILE=./secrets/minio-root-user
MINIO_ROOT_PASSWORD_FILE=./secrets/minio-root-password
MINIO_SERVER_CERT_FILE=./secrets/minio-server-cert.pem
MINIO_SERVER_KEY_FILE=./secrets/minio-server-key.pem
MINIO_SERVER_CA_FILE=./secrets/minio-server-ca.pem
NATS_SERVER_CERT_FILE=./secrets/nats-server-cert.pem
NATS_SERVER_KEY_FILE=./secrets/nats-server-key.pem
NATS_CLIENT_CA_FILE=./secrets/nats-client-ca.pem
CLICKHOUSE_API_SERVER_CERT_FILE=./secrets/clickhouse-api-server-cert.pem
CLICKHOUSE_API_SERVER_KEY_FILE=./secrets/clickhouse-api-server-key.pem
CLICKHOUSE_API_CLIENT_CA_FILE=./secrets/clickhouse-api-client-ca.pem
CLICKHOUSE_WRITER_CERT_FILE=./secrets/clickhouse-writer-cert.pem
CLICKHOUSE_WRITER_KEY_FILE=./secrets/clickhouse-writer-key.pem
ARCHIVE_API_SERVER_CERT_FILE=./secrets/archive-api-server-cert.pem
ARCHIVE_API_SERVER_KEY_FILE=./secrets/archive-api-server-key.pem
ARCHIVE_API_CLIENT_CA_FILE=./secrets/archive-api-client-ca.pem
ARCHIVE_WRITER_CERT_FILE=./secrets/archive-writer-cert.pem
ARCHIVE_WRITER_KEY_FILE=./secrets/archive-writer-key.pem
ARCHIVE_BACKEND_ACCESS_KEY_FILE=./secrets/archive-backend-access-key
ARCHIVE_BACKEND_SECRET_KEY_FILE=./secrets/archive-backend-secret-key
GATEWAY_SERVER_CERT_FILE=./secrets/gateway-server-cert.pem
GATEWAY_SERVER_KEY_FILE=./secrets/gateway-server-key.pem
GATEWAY_CLIENT_CA_FILE=./secrets/gateway-client-ca.pem
INGEST_BEARER_TOKEN_FILE=./secrets/ingest-bearer-token
NATS_USERNAME_FILE=./secrets/nats-username
NATS_PASSWORD_FILE=./secrets/nats-password
INGEST_NATS_CLIENT_CERT_FILE=./secrets/ingest-nats-client-cert.pem
INGEST_NATS_CLIENT_KEY_FILE=./secrets/ingest-nats-client-key.pem
INGEST_CLICKHOUSE_CLIENT_CERT_FILE=./secrets/ingest-clickhouse-client-cert.pem
INGEST_CLICKHOUSE_CLIENT_KEY_FILE=./secrets/ingest-clickhouse-client-key.pem
ARCHIVE_CLIENT_CA_FILE=./secrets/archive-client-ca.pem
INGEST_ARCHIVE_CLIENT_CERT_FILE=./secrets/ingest-archive-client-cert.pem
INGEST_ARCHIVE_CLIENT_KEY_FILE=./secrets/ingest-archive-client-key.pem
