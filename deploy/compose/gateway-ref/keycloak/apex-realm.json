      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "apex-control-lab-longlived-secret",
      "attributes": {
        "access.token.lifespan": "43200"
      },
      "protocolMappers": [
        {
