          "config": {
            "included.client.audience": "some-other-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "apex-control-scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "apex_control_scopes",
            "claim.value": "[\"acme/prod\"]",
            "jsonType.label": "JSON",
