            "access.tokenResponse.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "apex-control-wrong-audience",
      "name": "Apex OOB control gateway (wrong audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
