# The event-ingest and control-plane-api images both build from the repository
# root (each crate's build.rs needs contracts/, and control-plane-api also
# needs apps/event-ingest as a path dependency), so keep host build output,
# secrets, and unrelated trees out of the build context.
**/target/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.venv/
.git/
.github/
.local/
.claude/
.codex/
.cursor/
.impeccable/
.superpowers/
.worktrees/
**/dist/
apps/operator-ui/
docs/
examples/
rust-test-log-extracted/
deploy/compose/live-mtls/secrets/
deploy/compose/live-mtls/secrets-host/
deploy/compose/live-mtls/adversarial/
deploy/compose/secrets/
**/*.pem
**/*.key
